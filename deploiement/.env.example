# Copié en .env par scripts/sira au premier lancement. Aucun secret ici : ils sont générés par
# le conteneur « pki ». Socle seul ou démonstration : c'est la commande qui choisit
# (scripts/sira demarrer ou scripts/sira demo) ; COMPOSE_FILE n'a plus à figurer ici.
# Les versions des images sont épinglées par empreinte dans les fichiers Compose et Dockerfile.

# Port publié et adresse d'écoute. Changer le port impose « scripts/sira reinitialiser ».
SIRA_PORT=8600
SIRA_ADRESSE=127.0.0.1

# true quand un frontal TLS sert Sira en HTTPS : HSTS et cookies de session « Secure ».
SIRA_HTTPS=false

# Messagerie SMTP qui porte le code de connexion des citoyens (socle seul). En démonstration,
# Mailpit est utilisé et ces valeurs sont ignorées.
# SIRA_MESSAGERIE_HOTE=smtp.example
# SIRA_MESSAGERIE_PORT=587
# SIRA_MESSAGERIE_STARTTLS=true
# SIRA_MESSAGERIE_AUTH=true
# SIRA_MESSAGERIE_UTILISATEUR=sira
# SIRA_MESSAGERIE_MOT_DE_PASSE=
# SIRA_MESSAGERIE_EXPEDITEUR=ne-pas-repondre@sira.example

# Courriel des identifiants des agents (registres, services). Le mot de passe est celui
# d'application du compte d'envoi : à garder ici, dans .env, jamais dans le dépôt.
# SIRA_COURRIEL_HOTE=smtp.gmail.com
# SIRA_COURRIEL_PORT=587
# SIRA_COURRIEL_UTILISATEUR=compte@exemple.bf
# SIRA_COURRIEL_MOT_DE_PASSE=
# SIRA_COURRIEL_EXPEDITEUR=SIRA<compte@exemple.bf>
