{
  "name": "sira-interface",
  "version": "1.0.0",
  "description": "Interfaces du socle Sira : bibliothèque @sira/ui, espace citoyen, console, vitrine des composants.",
  "license": "EUPL-1.2",
  "private": true,
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": ">=24.14.0"
  },
  "scripts": {
    "ng": "ng",
    "demarrer": "ng serve",
    "construire": "ng build espace-citoyen && ng build console && ng build vitrine",
    "tester": "ng test ui --watch=false && ng test coquille --watch=false",
    "lint": "eslint . && prettier --check . && node outils/assembler-css.mjs --verifier",
    "format": "prettier --write .",
    "css": "node outils/assembler-css.mjs"
  },
  "dependencies": {
    "@angular/cdk": "21.2.14",
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@primeuix/themes": "2.0.3",
    "jsqr": "1.4.0",
    "primeng": "21.1.10",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "21.2.29",
    "@angular/cli": "21.2.29",
    "@angular/compiler-cli": "21.2.25",
    "@eslint/js": "10.0.1",
    "@tailwindcss/postcss": "4.3.5",
    "angular-eslint": "21.4.0",
    "eslint": "10.13.0",
    "eslint-config-prettier": "10.1.8",
    "jsdom": "28.1.0",
    "postcss": "8.5.33",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.5",
    "tailwindcss-primeui": "0.6.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vitest": "4.1.12"
  }
