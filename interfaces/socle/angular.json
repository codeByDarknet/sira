{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "espace-citoyen": {
      "projectType": "application",
      "root": "projects/espace-citoyen",
      "sourceRoot": "projects/espace-citoyen/src",
      "prefix": "ec",
      "schematics": {
        "@schematics/angular:component": {
          "style": "none",
          "changeDetection": "OnPush",
          "skipTests": true
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/espace-citoyen/src/main.ts",
            "tsConfig": "projects/espace-citoyen/tsconfig.app.json",
            "allowedCommonJsDependencies": ["jsqr"],
            "outputPath": "dist/espace-citoyen",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/espace-citoyen/public"
              },
              {
                "glob": "icones.svg",
                "input": "projects/ui/assets",
                "output": "assets/sira"
              },
              {
                "glob": "{marque/*.png,photos/*.jpg}",
                "input": "projects/ui/assets",
                "output": "assets/sira"
              },
              {
                "glob": "favicon.svg",
                "input": "projects/ui/assets",
                "output": "/"
              }
            ],
            "styles": [
              "projects/ui/styles/tailwind.css",
              "projects/ui/styles/index.css",
              "projects/espace-citoyen/src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "900kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4201
          },
          "configurations": {
            "production": {
              "buildTarget": "espace-citoyen:build:production"
            },
            "development": {
              "buildTarget": "espace-citoyen:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "espace-citoyen:build:development",
            "tsConfig": "tsconfig.spec.json"
          }
        }
      }
    },
