{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": false
  },
  "newProjectRoot": "projects",
  "projects": {
    "portail-service": {
      "projectType": "application",
      "root": "projects/portail-service",
      "sourceRoot": "projects/portail-service/src",
      "prefix": "ps",
      "schematics": {
        "@schematics/angular:component": {
          "style": "none",
          "changeDetection": "OnPush",
          "skipTests": true
        }
      },
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "projects/portail-service/src/main.ts",
            "tsConfig": "projects/portail-service/tsconfig.app.json",
            "outputPath": "dist/portail-service",
            "assets": [
              {
                "glob": "**/*",
                "input": "projects/portail-service/public"
              },
              {
                "glob": "pdf.worker.min.mjs",
                "input": "node_modules/pdfjs-dist/build",
                "output": "assets/pdfjs"
              },
              {
                "glob": "icones.svg",
                "input": "bibliotheques/ui/assets",
                "output": "assets/sira"
              },
              {
                "glob": "{marque/*.png,photos/*.jpg}",
                "input": "bibliotheques/ui/assets",
                "output": "assets/sira"
              },
              {
                "glob": "favicon.svg",
                "input": "bibliotheques/ui/assets",
                "output": "/"
              }
            ],
            "styles": [
              "bibliotheques/ui/styles/tailwind.css",
              "bibliotheques/ui/styles/index.css",
              "commun/demo.css"
            ]
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "750kB",
                  "maximumError": "900kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all",
              "optimization": {
                "scripts": true,
                "styles": {
                  "minify": true,
                  "inlineCritical": false
                },
                "fonts": false
              }
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "options": {
            "port": 4211
          },
          "configurations": {
            "production": {
              "buildTarget": "portail-service:build:production"
            },
            "development": {
              "buildTarget": "portail-service:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "portail-service:build:development",
            "tsConfig": "projects/portail-service/tsconfig.spec.json"
          }
        }
      }
    },
