      "clientId": "demo-concours",
      "name": "Concours de la fonction publique",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": false,
      "clientAuthenticatorType": "client-x509",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": true,
      "fullScopeAllowed": false,
      "rootUrl": "http://concours.sira.localhost:${SIRA_PORT}",
      "baseUrl": "/",
      "redirectUris": [
        "http://concours.sira.localhost:${SIRA_PORT}/api/auth/retour"
      ],
      "webOrigins": [],
      "attributes": {
        "x509.subjectdn": "CN=urn:sira:service:concours,OU=tls,O=Sira",
        "x509.allow.regex.pattern.comparison": "false",
        "x509.casubjectdn": "CN=AC Sira,O=Sira",
        "tls.client.certificate.bound.access.tokens": "true",
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://concours.sira.localhost:${SIRA_PORT}/"
      },
      "defaultClientScopes": [
        "basic",
        "acr",
        "profile"
      ],
      "optionalClientScopes": [],
      "protocolMappers": [
        {
          "name": "audience-demo-concours",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "demo-concours",
            "access.token.claim": "true",
            "id.token.claim": "false",
            "introspection.token.claim": "true"
          }
        },
        {
          "name": "administration",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-attribute-mapper",
          "config": {
            "user.attribute": "administration",
            "claim.name": "administration",
            "jsonType.label": "String",
            "access.token.claim": "true",
            "id.token.claim": "true",
