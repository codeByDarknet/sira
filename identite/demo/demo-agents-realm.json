{
  "realm": "demo-agents",
  "displayName": "Sira",
  "displayNameHtml": "Agents des administrations",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "rememberMe": false,
  "editUsernameAllowed": false,
  "loginWithEmailAllowed": true,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "passwordPolicy": "length(12) and maxLength(128) and upperCase(1) and lowerCase(1) and digits(1) and specialChars(1) and notUsername and notEmail and passwordHistory(3)",
  "smtpServer": {
    "host": "${SIRA_COURRIEL_HOTE}",
    "port": "${SIRA_COURRIEL_PORT}",
    "starttls": "true",
    "ssl": "false",
    "auth": "true",
    "user": "${SIRA_COURRIEL_UTILISATEUR}",
    "password": "${SIRA_COURRIEL_MOT_DE_PASSE}",
    "from": "${SIRA_COURRIEL_ADRESSE}",
    "fromDisplayName": "Sira"
  },
  "eventsEnabled": true,
  "eventsListeners": [
    "jboss-logging"
  ],
  "eventsExpiration": 2592000,
  "browserFlow": "sira-agents",
  "authenticationFlows": [
    {
      "alias": "sira-agents",
      "description": "Mot de passe et code TOTP, tous deux obligatoires",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "auth-cookie"
        },
        {
          "requirement": "ALTERNATIVE",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": true,
          "flowAlias": "sira-agents-formulaire"
        }
      ]
    },
    {
      "alias": "sira-agents-formulaire",
      "description": "Mot de passe puis code TOTP",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": false,
      "authenticationExecutions": [
        {
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "auth-username-password-form"
        },
        {
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "authenticatorFlow": false,
          "authenticator": "sira-code-totp"
        }
      ]
    }
  ],
  "adminEventsEnabled": true,
  "adminEventsDetailsEnabled": false,
  "failureFactor": 10,
  "internationalizationEnabled": true,
  "supportedLocales": [
    "fr"
  ],
  "defaultLocale": "fr",
  "loginTheme": "sira",
  "accessTokenLifespan": 300,
  "accessCodeLifespan": 60,
  "ssoSessionIdleTimeout": 900,
  "ssoSessionMaxLifespan": 28800,
  "requiredActions": [
